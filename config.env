# ==============================================================================
# Xschem & Open PDK Suite - Installer Configuration
# ==============================================================================

# Target install directory for binaries and wrappers
INSTALL_BIN_DIR="${HOME}/.local/bin"
INSTALL_LIB_DIR="${HOME}/.local/lib"
INSTALL_INC_DIR="${HOME}/.local/include"
INSTALL_SHARE_DIR="${HOME}/.local/share"

# Unified PDK Directory
PDK_ROOT="${HOME}/pdk"

# Conda / Environment settings
CONDA_DIR="${HOME}/miniforge3"
CONDA_ENV_NAME="eda"

# Tool versions & download URLs
OPENVAF_VERSION="23.5.0"
OPENVAF_URL="https://openvaf.semimod.de/download/openvaf_${OPENVAF_VERSION//./_}_linux_x86_64.tar.gz"

# Repositories
IHP_PDK_REPO="https://github.com/IHP-GmbH/IHP-Open-PDK.git"
GAW_REPO="https://github.com/StefanSchippers/xschem-gaw.git"

# Default PDK technology variants
PDK_IHP_NAME="ihp-sg13g2"
PDK_SKY130_NAME="sky130A"
PDK_GF180_NAME="gf180mcuD"

# Channel list for conda (using libmamba)
CONDA_CHANNELS="-c conda-forge -c litex-hub -c unic-cass --override-channels"
